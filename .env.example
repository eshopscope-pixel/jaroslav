# Copy to .env for local runs. In the cloud, set these as environment variables of the claude.ai cloud environment.

# Instagram (Meta Business Suite -> system user token with instagram_basic, instagram_content_publish, pages_show_list, business_management)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v23.0

# Telegram bot for previews (@BotFather) and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where Instagram downloads slides from (public GitHub repo, queue branch)
# e.g. https://raw.githubusercontent.com/<user>/eshopscope-ig-autopilot/refs/heads/claude/ig-queue
PUBLIC_BASE_URL=

# Photo search APIs (free) - at least one
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Review window before auto-publish, minutes
REVIEW_MINUTES=60
